# Copy this file to .env in the project root and fill in what you use.
# Never commit the real .env.

# Optional. Leave blank to run in LOCAL ANALYSIS MODE (no data leaves the
# machine). When set, Gemini is used ONLY for narrative/sentiment/comment-theme
# /issue-extraction NLP tasks -- never for core metrics, which are always
# computed deterministically in Python.
GEMINI_API_KEY=

# Gemini model name, only used if GEMINI_API_KEY is set.
GEMINI_MODEL=gemini-2.0-flash

# Optional. Local, fully-offline HuggingFace sentiment models -- needs
# `pip install transformers torch` (see requirements.txt). Used ONLY as a
# step up from the keyword-lexicon fallback for SENTIMENT (narrative/
# comment-theme/issue-extraction are unaffected). Devanagari-script text
# (Marathi) is routed to MARATHI_SENTIMENT_MODEL; everything else (English,
# transliterated text) uses SENTIMENT_MODEL. Gemini, if enabled, still takes
# priority over both. Leave both blank to keep the zero-dependency lexicon.
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
MARATHI_SENTIMENT_MODEL=l3cube-pune/marathi-sentiment-md

# Root data directory (raw/processed/analysis/mock). A blank value here (or
# deleting this line entirely) both correctly default to ./data relative to
# the project root.
DATA_DIR=

# Default comparison window in days, used when the UI doesn't specify one.
DEFAULT_PERIOD_DAYS=30

# Display timezone (data is stored normalized to UTC where possible).
DISPLAY_TIMEZONE=Asia/Kolkata

# CORS origin for the Vite dev server.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional. Full path to a Python interpreter that has selenium +
# webdriver-manager (for Instagram) and playwright (for Facebook) installed.
# Leave blank to auto-detect -- the backend checks `py -0p` and common
# install paths and picks whichever interpreter actually has both. Only set
# this if auto-detection picks the wrong one on your machine.
PYTHON_EXECUTABLE=
