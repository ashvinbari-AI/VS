# Secrets
.env

# Python
__pycache__/
*.pyc
backend/.venv/
.pytest_cache/

# Node / frontend
frontend/node_modules/
frontend/dist/

# Scraper sessions (browser profiles / cookies -- never share these)
fb_session/
ig_session/

# App data (raw scraped evidence, processed parquet, logs) -- local-only,
# never committed. Keep the folder structure with .gitkeep if needed.
data/raw/
data/processed/
data/analysis/
data/mock/
logs/
output/

# Evaluation run output -- regenerable via `python -m evaluation.run`.
# Ground truth, config, and code are NOT ignored: those are the actual
# evaluation system, not its output.
evaluation/reports/*.json
evaluation/reports/*.csv
evaluation/regression/baseline/*.json
evaluation/regression/current/*.json
